{
  "name": "aetherdesk",
  "version": "2.0.0",
  "description": "Next-Gen Linux Developer Cockpit & System Telemetry HUD",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "build": "pnpm --filter client build",
    "test": "node --test server/tests/*.test.js",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "node --watch server/index.js",
    "dev": "node server/index.js"
  },
  "keywords": [
    "linux",
    "cockpit",
    "dashboard",
    "telemetry",
    "kanban",
    "pomodoro",
    "webhook",
    "omarchy"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  }
}
